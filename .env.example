# Copy to .env and fill in. Generate a secret with: openssl rand -base64 48
JWT_SECRET=

# WSO2 account the backend uses to get its own WSO2 tokens. Defaults to admin/admin,
# WSO2's out-of-the-box login; change both in WSO2 and here for anything shared.
# WSO2_USERNAME=admin
# WSO2_PASSWORD=admin
# Optional: an existing OAuth client (password grant). Without one, the backend
# registers "opengate_backend" with WSO2 on first use.
# WSO2_CLIENT_ID=
# WSO2_CLIENT_SECRET=

# Optional: WSO2's [encryption] key (64 hex characters), which encrypts secrets
# such as provider keys. Unset, one is generated once and kept on WSO2's
# database volume; set it to manage the key yourself (e.g. in production).
# WSO2_ENCRYPTION_KEY=

# Provider keys for APIs that need one (see README, "APIs that need a provider
# key"). Used by scripts/seed-public-apis.sh and scripts/record-examples.mjs.
# NASA: free, instant at https://api.nasa.gov (falls back to DEMO_KEY if unset).
# NASA_API_KEY=

# ── Hosting on a server (README §9) ─────────────────────────────────────────
# Public hostnames behind nginx on 443. WSO2_HOSTNAME is the Publisher's
# (WSO2 builds its sign-in redirects from it); WSO2_GATEWAY_HOST is where
# applications call APIs (it becomes the gateway vhost, and the seed script
# deploys APIs to it).
# WSO2's admin password. Set it before WSO2's first start on
# the server, and set WSO2_PASSWORD (above) to the same value.
# WSO2_ADMIN_PASSWORD=
# WSO2_HOSTNAME=portal.example.com
# WSO2_GATEWAY_HOST=gateway.example.com
# What the dashboard shows developers in examples and the user guide.
# PUBLIC_GATEWAY_URL=https://gateway.example.com
# PUBLIC_PORTAL_URL=https://portal.example.com
# PUBLIC_API_URL=https://api.example.com
