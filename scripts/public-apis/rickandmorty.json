{
  "openapi": "3.0.1",
  "info": {
    "title": "RickAndMorty",
    "version": "1.0.0",
    "description": "Characters, locations and episodes from the TV show Rick and Morty. Docs: https://rickandmortyapi.com/documentation"
  },
  "x-opengate": {
    "context": "/rickandmorty",
    "backend": "https://rickandmortyapi.com/api",
    "tags": [
      "fun",
      "tv"
    ]
  },
  "paths": {
    "/character": {
      "get": {
        "summary": "Search characters",
        "description": "Pages of 20. All filters are optional and can be combined.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Part of the character's name.",
            "schema": {
              "type": "string"
            },
            "example": "rick"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Status.",
            "schema": {
              "type": "string",
              "enum": [
                "alive",
                "dead",
                "unknown"
              ]
            },
            "example": "alive"
          },
          {
            "name": "species",
            "in": "query",
            "description": "Species, e.g. Human.",
            "schema": {
              "type": "string"
            },
            "x-test-value": "Human"
          },
          {
            "name": "gender",
            "in": "query",
            "description": "Gender.",
            "schema": {
              "type": "string",
              "enum": [
                "female",
                "male",
                "genderless",
                "unknown"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of characters, with paging info",
            "content": {
              "application/json": {
                "example": {
                  "info": {
                    "count": 29,
                    "pages": 2,
                    "next": "https://rickandmortyapi.com/api/character?page=2&name=rick&status=alive",
                    "prev": null
                  },
                  "results": [
                    {
                      "id": 1,
                      "name": "Rick Sanchez",
                      "status": "Alive",
                      "species": "Human",
                      "type": "",
                      "gender": "Male",
                      "origin": {
                        "name": "Earth (C-137)",
                        "url": "https://rickandmortyapi.com/api/location/1"
                      },
                      "location": {
                        "name": "Citadel of Ricks",
                        "url": "https://rickandmortyapi.com/api/location/3"
                      },
                      "image": "https://rickandmortyapi.com/api/character/avatar/1.jpeg",
                      "episode": [
                        "https://rickandmortyapi.com/api/episode/1",
                        "https://rickandmortyapi.com/api/episode/2"
                      ],
                      "url": "https://rickandmortyapi.com/api/character/1",
                      "created": "2017-11-04T18:48:46.250Z"
                    },
                    {
                      "id": 48,
                      "name": "Black Rick",
                      "status": "Alive",
                      "species": "Human",
                      "type": "",
                      "gender": "Male",
                      "origin": {
                        "name": "unknown",
                        "url": ""
                      },
                      "location": {
                        "name": "Citadel of Ricks",
                        "url": "https://rickandmortyapi.com/api/location/3"
                      },
                      "image": "https://rickandmortyapi.com/api/character/avatar/48.jpeg",
                      "episode": [
                        "https://rickandmortyapi.com/api/episode/22",
                        "https://rickandmortyapi.com/api/episode/28"
                      ],
                      "url": "https://rickandmortyapi.com/api/character/48",
                      "created": "2017-11-05T11:15:26.044Z"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No characters match"
          }
        }
      }
    },
    "/character/{id}": {
      "get": {
        "summary": "Get characters by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "A character ID, or several separated by commas (e.g. 1,2,3) to get an array.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "The character",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name": "Rick Sanchez",
                  "status": "Alive",
                  "species": "Human",
                  "type": "",
                  "gender": "Male",
                  "origin": {
                    "name": "Earth (C-137)",
                    "url": "https://rickandmortyapi.com/api/location/1"
                  },
                  "location": {
                    "name": "Citadel of Ricks",
                    "url": "https://rickandmortyapi.com/api/location/3"
                  },
                  "image": "https://rickandmortyapi.com/api/character/avatar/1.jpeg",
                  "episode": [
                    "https://rickandmortyapi.com/api/episode/1",
                    "https://rickandmortyapi.com/api/episode/2"
                  ],
                  "url": "https://rickandmortyapi.com/api/character/1",
                  "created": "2017-11-04T18:48:46.250Z"
                }
              }
            }
          },
          "404": {
            "description": "No such character"
          }
        }
      }
    },
    "/location": {
      "get": {
        "summary": "Search locations",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Part of the location's name.",
            "schema": {
              "type": "string"
            },
            "example": "earth"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Location type, e.g. Planet.",
            "schema": {
              "type": "string"
            },
            "x-test-value": "Planet"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of locations",
            "content": {
              "application/json": {
                "example": {
                  "info": {
                    "count": 27,
                    "pages": 2,
                    "next": "https://rickandmortyapi.com/api/location?page=2&name=earth",
                    "prev": null
                  },
                  "results": [
                    {
                      "id": 1,
                      "name": "Earth (C-137)",
                      "type": "Planet",
                      "dimension": "Dimension C-137",
                      "residents": [
                        "https://rickandmortyapi.com/api/character/38",
                        "https://rickandmortyapi.com/api/character/45"
                      ],
                      "url": "https://rickandmortyapi.com/api/location/1",
                      "created": "2017-11-10T12:42:04.162Z"
                    },
                    {
                      "id": 8,
                      "name": "Post-Apocalyptic Earth",
                      "type": "Planet",
                      "dimension": "Post-Apocalyptic Dimension",
                      "residents": [
                        "https://rickandmortyapi.com/api/character/25",
                        "https://rickandmortyapi.com/api/character/52"
                      ],
                      "url": "https://rickandmortyapi.com/api/location/8",
                      "created": "2017-11-10T13:09:22.551Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/episode": {
      "get": {
        "summary": "Search episodes",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Part of the episode's name.",
            "schema": {
              "type": "string"
            },
            "example": "pilot"
          },
          {
            "name": "episode",
            "in": "query",
            "description": "Episode code, e.g. S01E01.",
            "schema": {
              "type": "string"
            },
            "x-test-value": "S01E01"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of episodes",
            "content": {
              "application/json": {
                "example": {
                  "info": {
                    "count": 1,
                    "pages": 1,
                    "next": null,
                    "prev": null
                  },
                  "results": [
                    {
                      "id": 1,
                      "name": "Pilot",
                      "air_date": "December 2, 2013",
                      "episode": "S01E01",
                      "characters": [
                        "https://rickandmortyapi.com/api/character/1",
                        "https://rickandmortyapi.com/api/character/2"
                      ],
                      "url": "https://rickandmortyapi.com/api/episode/1",
                      "created": "2017-11-10T12:56:33.798Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
