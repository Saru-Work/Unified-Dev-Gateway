{
  "openapi": "3.0.1",
  "info": {
    "title": "JSONPlaceholder",
    "version": "1.0.0",
    "description": "Fake REST data for testing and prototyping: posts, comments, users and todos. Writes are accepted but not saved. Docs: https://jsonplaceholder.typicode.com/guide/"
  },
  "x-opengate": {
    "context": "/jsonplaceholder",
    "backend": "https://jsonplaceholder.typicode.com",
    "tags": [
      "demo",
      "testing"
    ]
  },
  "paths": {
    "/posts": {
      "get": {
        "summary": "List posts",
        "description": "All 100 posts, or only one user's posts.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "description": "Only posts by this user (1–10).",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Posts",
            "content": {
              "application/json": {
                "example": [
                  {
                    "userId": 1,
                    "id": 1,
                    "title": "sunt aut facere repellat provident occaecati excepturi optio reprehenderit",
                    "body": "quia et suscipit\nsuscipit recusandae consequuntur expedita et cum\nreprehenderit molestiae ut ut quas totam\nnostrum rerum est autem sunt rem eveniet architecto"
                  },
                  {
                    "userId": 1,
                    "id": 2,
                    "title": "qui est esse",
                    "body": "est rerum tempore vitae\nsequi sint nihil reprehenderit dolor beatae ea dolores neque\nfugiat blanditiis voluptate porro vel nihil molestiae ut reiciendis\nqui ape…"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a post",
        "description": "Pretends to create a post and echoes it back with an id. Nothing is saved.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "body",
                  "userId"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Post title"
                  },
                  "body": {
                    "type": "string",
                    "description": "Post text"
                  },
                  "userId": {
                    "type": "integer",
                    "description": "Author (1–10)"
                  }
                }
              },
              "example": {
                "title": "Hello",
                "body": "My first post",
                "userId": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (not saved)",
            "content": {
              "application/json": {
                "example": {
                  "id": 101,
                  "title": "Hello",
                  "body": "My first post",
                  "userId": 1
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get a post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Post ID (1–100).",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "The post",
            "content": {
              "application/json": {
                "example": {
                  "userId": 1,
                  "id": 1,
                  "title": "sunt aut facere repellat provident occaecati excepturi optio reprehenderit",
                  "body": "quia et suscipit\nsuscipit recusandae consequuntur expedita et cum\nreprehenderit molestiae ut ut quas totam\nnostrum rerum est autem sunt rem eveniet architecto"
                }
              }
            }
          },
          "404": {
            "description": "No such post"
          }
        }
      }
    },
    "/posts/{id}/comments": {
      "get": {
        "summary": "List a post's comments",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Post ID (1–100).",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Comments",
            "content": {
              "application/json": {
                "example": [
                  {
                    "postId": 1,
                    "id": 1,
                    "name": "id labore ex et quam laborum",
                    "email": "Eliseo@gardner.biz",
                    "body": "laudantium enim quasi est quidem magnam voluptate ipsam eos\ntempora quo necessitatibus\ndolor quam autem quasi\nreiciendis et nam sapiente accusantium"
                  },
                  {
                    "postId": 1,
                    "id": 2,
                    "name": "quo vero reiciendis velit similique earum",
                    "email": "Jayne_Kuhic@sydney.com",
                    "body": "est natus enim nihil est dolore omnis voluptatem numquam\net omnis occaecati quod ullam at\nvoluptatem error expedita pariatur\nnihil sint nostrum voluptatem reici…"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "description": "The 10 sample users.",
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "name": "Leanne Graham",
                    "username": "Bret",
                    "email": "Sincere@april.biz",
                    "address": {
                      "street": "Kulas Light",
                      "suite": "Apt. 556",
                      "city": "Gwenborough",
                      "zipcode": "92998-3874",
                      "geo": {
                        "lat": "-37.3159",
                        "lng": "81.1496"
                      }
                    },
                    "phone": "1-770-736-8031 x56442",
                    "website": "hildegard.org",
                    "company": {
                      "name": "Romaguera-Crona",
                      "catchPhrase": "Multi-layered client-server neural-net",
                      "bs": "harness real-time e-markets"
                    }
                  },
                  {
                    "id": 2,
                    "name": "Ervin Howell",
                    "username": "Antonette",
                    "email": "Shanna@melissa.tv",
                    "address": {
                      "street": "Victor Plains",
                      "suite": "Suite 879",
                      "city": "Wisokyburgh",
                      "zipcode": "90566-7771",
                      "geo": {
                        "lat": "-43.9509",
                        "lng": "-34.4618"
                      }
                    },
                    "phone": "010-692-6593 x09125",
                    "website": "anastasia.net",
                    "company": {
                      "name": "Deckow-Crist",
                      "catchPhrase": "Proactive didactic contingency",
                      "bs": "synergize scalable supply-chains"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get a user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "User ID (1–10).",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "The user, with address and company",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name": "Leanne Graham",
                  "username": "Bret",
                  "email": "Sincere@april.biz",
                  "address": {
                    "street": "Kulas Light",
                    "suite": "Apt. 556",
                    "city": "Gwenborough",
                    "zipcode": "92998-3874",
                    "geo": {
                      "lat": "-37.3159",
                      "lng": "81.1496"
                    }
                  },
                  "phone": "1-770-736-8031 x56442",
                  "website": "hildegard.org",
                  "company": {
                    "name": "Romaguera-Crona",
                    "catchPhrase": "Multi-layered client-server neural-net",
                    "bs": "harness real-time e-markets"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such user"
          }
        }
      }
    },
    "/todos": {
      "get": {
        "summary": "List todos",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "description": "Only this user's todos (1–10).",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "completed",
            "in": "query",
            "description": "Only done (true) or open (false) todos.",
            "schema": {
              "type": "boolean"
            },
            "x-test-value": false
          }
        ],
        "responses": {
          "200": {
            "description": "Todos",
            "content": {
              "application/json": {
                "example": [
                  {
                    "userId": 1,
                    "id": 1,
                    "title": "delectus aut autem",
                    "completed": false
                  },
                  {
                    "userId": 1,
                    "id": 2,
                    "title": "quis ut nam facilis et officia qui",
                    "completed": false
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
