{
  "openapi": "3.0.1",
  "info": {
    "title": "NasaAsteroids",
    "version": "1.0.0",
    "description": "Near-Earth asteroids from NASA's NeoWs service: close approaches by date, and details of any asteroid by ID. OpenGate adds NASA's API key for you. Docs: https://api.nasa.gov"
  },
  "x-opengate": {
    "context": "/nasa/neo",
    "backend": "https://api.nasa.gov/neo/rest/v1",
    "tags": [
      "space",
      "science"
    ],
    "providerKey": {
      "in": "header",
      "name": "X-Api-Key",
      "env": "NASA_API_KEY",
      "fallback": "DEMO_KEY",
      "redact": [
        "api_key"
      ]
    }
  },
  "paths": {
    "/feed": {
      "get": {
        "summary": "Asteroids passing close to Earth between two dates",
        "description": "Grouped by date. The range can be at most 7 days.",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "description": "First day, as YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-20"
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Last day, as YYYY-MM-DD; 7 days after start_date if left out.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-21"
          }
        ],
        "responses": {
          "200": {
            "description": "How many asteroids, and each one's size, speed and miss distance by date",
            "content": {
              "application/json": {
                "example": {
                  "element_count": 7,
                  "links": {
                    "next": "http://api.nasa.gov/neo/rest/v1/feed?start_date=2026-11-21&end_date=2026-11-22&detailed=false&api_key=*****",
                    "previous": "http://api.nasa.gov/neo/rest/v1/feed?start_date=2026-11-19&end_date=2026-11-20&detailed=false&api_key=*****",
                    "self": "http://api.nasa.gov/neo/rest/v1/feed?start_date=2026-11-20&end_date=2026-11-21&detailed=false&api_key=*****"
                  },
                  "near_earth_objects": {
                    "2026-11-21": [
                      {
                        "absolute_magnitude_h": 24,
                        "close_approach_data": [
                          {}
                        ],
                        "estimated_diameter": {
                          "feet": {},
                          "kilometers": {},
                          "meters": {},
                          "miles": {}
                        },
                        "id": "3447917",
                        "is_potentially_hazardous_asteroid": false,
                        "is_sentry_object": false,
