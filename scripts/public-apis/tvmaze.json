    "/shows/{id}/episodes": {
      "get": {
        "summary": "A show's episodes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "TVMaze show ID.",
            "schema": {
              "type": "integer"
            },
            "example": 526
          },
          {
            "name": "specials",
            "in": "query",
            "description": "1 to include specials.",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Episodes in order",
            "content": {
